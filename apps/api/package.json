{
  "name": "@delisp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply delisp --local",
    "migrate:remote": "wrangler d1 migrations apply delisp --remote"
  },
  "dependencies": {
    "@delisp/schema": "workspace:*",
    "drizzle-orm": "0.38.3",
    "hono": "4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.5.40",
    "@cloudflare/workers-types": "4.20241230.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "wrangler": "3.99.0"
  }
}
