{
  "name": "delisp",
  "private": true,
  "version": "0.1.0",
  "description": "Pronunciation Trainer — a single-user PWA for correcting a mild /s/ lisp",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @delisp/web build",
    "content:build": "node content/build.mjs",
    "content:seed": "node content/seed.mjs > packages/schema/seed/exercises.sql",
    "dev": "pnpm --filter @delisp/web dev",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @delisp/dsp test:watch",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "yaml": "2.6.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
